<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MoorkszVisoryMediaDownloader</AssemblyName>
    <RootNamespace>MoorkszVisoryMediaDownloader.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MoorkszVisoryMediaDownloader.Core\MoorkszVisoryMediaDownloader.Core.csproj" />
  </ItemGroup>

  <!-- The icon is kept as Base64 text so the source tree stays text-only; it is decoded deterministically before build. -->
  <PropertyGroup>
    <GeneratedAppIcon>$(BaseIntermediateOutputPath)app.ico</GeneratedAppIcon>
    <ApplicationIcon>$(GeneratedAppIcon)</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="$(GeneratedAppIcon)" Link="app.ico" />
  </ItemGroup>
  <UsingTask TaskName="DecodeBase64File" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var bytes = System.Convert.FromBase64String(System.IO.File.ReadAllText(Source));
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(System.IO.Path.GetFullPath(Destination)));
        if (!System.IO.File.Exists(Destination) || !System.Linq.Enumerable.SequenceEqual(System.IO.File.ReadAllBytes(Destination), bytes))
            System.IO.File.WriteAllBytes(Destination, bytes);
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="DecodeAppIcon" BeforeTargets="PrepareForBuild">
    <DecodeBase64File Source="$(MSBuildProjectDirectory)\app.ico.b64" Destination="$(GeneratedAppIcon)" />
  </Target>
</Project>
