<Window x:Class="MoorkszVisoryMediaDownloader.App.Visory.ScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:MoorkszVisoryMediaDownloader.App"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding [ScanWindowTitle], Source={x:Static app:Loc.Instance}}"
        Width="1180" Height="820" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Text.Heading}" Margin="0,0,0,2" Text="{Binding [ScanWindowTitle], Source={x:Static app:Loc.Instance}}" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding [ScanInstructions], Source={x:Static app:Loc.Instance}}" />
                    <TextBlock x:Name="CounterText" Margin="0,6,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="NoteText" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="AutoScrollButton" Padding="14,7" MinHeight="34" Click="OnAutoScroll"
                                  Content="{Binding [AutoScroll], Source={x:Static app:Loc.Instance}}" />
                    <Button x:Name="DiagnosticsButton" Style="{StaticResource Button.Secondary}" Click="OnDiagnostics" Visibility="Collapsed"
                            Content="{Binding [Diagnostics], Source={x:Static app:Loc.Instance}}" />
                    <Button Style="{StaticResource Button.Secondary}" IsCancel="True" Click="OnCancel"
                            Content="{Binding [Cancel], Source={x:Static app:Loc.Instance}}" />
                    <Button x:Name="FinishButton" Style="{StaticResource Button.Primary}" Margin="8,0,0,0" Click="OnFinish"
                            Content="{Binding [FinishScan], Source={x:Static app:Loc.Instance}}" />
                </StackPanel>
            </Grid>
        </Border>
        <wv2:WebView2 x:Name="Web" Grid.Row="1" AutomationProperties.Name="Visory" />
        <Border x:Name="MissingPanel" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource Brush.Window}">
            <Border Style="{StaticResource Card}" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="MissingText" Style="{StaticResource Text.Body}" Text="{Binding [WebView2Missing], Source={x:Static app:Loc.Instance}}" />
                    <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnInstallWebView2"
                            Content="{Binding [InstallWebView2], Source={x:Static app:Loc.Instance}}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
