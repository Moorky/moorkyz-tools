<UserControl x:Class="MoorkszVisoryMediaDownloader.App.Views.RecordingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:MoorkszVisoryMediaDownloader.App">
    <Grid Margin="32,0,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <WrapPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
            <StackPanel Margin="0,0,12,8">
                <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [Search], Source={x:Static app:Loc.Instance}}" />
                <TextBox Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" AutomationProperties.Name="{Binding [Search], Source={x:Static app:Loc.Instance}}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,8">
                <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [StatusFilter], Source={x:Static app:Loc.Instance}}" />
                <ComboBox Width="170" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" DisplayMemberPath="Label"
                          AutomationProperties.Name="{Binding [StatusFilter], Source={x:Static app:Loc.Instance}}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,8">
                <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [CameraFilter], Source={x:Static app:Loc.Instance}}" />
                <ComboBox Width="170" ItemsSource="{Binding CameraFilters}" SelectedItem="{Binding CameraFilter}"
                          AutomationProperties.Name="{Binding [CameraFilter], Source={x:Static app:Loc.Instance}}" />
            </StackPanel>
        </WrapPanel>

        <DataGrid x:Name="RecordingsGrid" Grid.Row="1" ItemsSource="{Binding RecordingsView}" SelectedItem="{Binding SelectedRecording}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="None"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                  AutomationProperties.Name="{Binding [NavRecordings], Source={x:Static app:Loc.Instance}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding [ColCamera], Source={x:Static app:Loc.Instance}}" Binding="{Binding Camera}" Width="*" MinWidth="120" />
                <DataGridTextColumn Header="{Binding [ColRecorded], Source={x:Static app:Loc.Instance}}" Binding="{Binding Recorded}" SortMemberPath="RecordedSort" Width="150" />
                <DataGridTextColumn Header="{Binding [ColName], Source={x:Static app:Loc.Instance}}" Binding="{Binding Name}" Width="2*" MinWidth="180" />
                <DataGridTextColumn Header="{Binding [ColSize], Source={x:Static app:Loc.Instance}}" Binding="{Binding SizeText}" SortMemberPath="SizeSort" Width="100" />
                <DataGridTextColumn Header="{Binding [ColType], Source={x:Static app:Loc.Instance}}" Binding="{Binding Type}" Width="70" />
                <DataGridTextColumn Header="{Binding [ColStatus], Source={x:Static app:Loc.Instance}}" Binding="{Binding Status}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Style="{StaticResource Button.Primary}" Margin="0,0,8,8" Command="{Binding BackupSelectedCommand}" CommandParameter="{Binding SelectedItems, ElementName=RecordingsGrid}"
                    Content="{Binding [DownloadSelected], Source={x:Static app:Loc.Instance}}" />
            <Button Style="{DynamicResource Button.Secondary}" Margin="0,0,8,8" Command="{Binding VerifySelectedCommand}" CommandParameter="{Binding SelectedItems, ElementName=RecordingsGrid}"
                    Content="{Binding [VerifySelected], Source={x:Static app:Loc.Instance}}" />
            <Button Style="{DynamicResource Button.Secondary}" Margin="0,0,8,8" Command="{Binding VerifyAllCommand}"
                    Content="{Binding [VerifyAll], Source={x:Static app:Loc.Instance}}" />
            <TextBlock Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="4,0,0,8" Text="{Binding VerifyProgressText}" AutomationProperties.LiveSetting="Polite" />
        </WrapPanel>

        <Border Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Heading}" Text="{Binding [Details], Source={x:Static app:Loc.Instance}}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding [NoSelection], Source={x:Static app:Loc.Instance}}" Visibility="{Binding HasSelectedRecording, Converter={StaticResource Hidden}}" />
                    <StackPanel DataContext="{Binding SelectedRecording}" Visibility="{Binding DataContext.HasSelectedRecording, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}">
                        <StackPanel.Resources>
                            <Style TargetType="TextBox">
                                <Setter Property="IsReadOnly" Value="True" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [RecordingId], Source={x:Static app:Loc.Instance}}" />
                        <TextBox Text="{Binding Id, Mode=OneWay}" AutomationProperties.Name="{Binding [RecordingId], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [ColCamera], Source={x:Static app:Loc.Instance}}" />
                        <TextBox Text="{Binding Camera, Mode=OneWay}" AutomationProperties.Name="{Binding [ColCamera], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [ColRecorded], Source={x:Static app:Loc.Instance}}" />
                        <TextBox Text="{Binding Recorded, Mode=OneWay}" AutomationProperties.Name="{Binding [ColRecorded], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [RecordedAtSource], Source={x:Static app:Loc.Instance}}" />
                        <TextBox Text="{Binding DateSource, Mode=OneWay}" AutomationProperties.Name="{Binding [RecordedAtSource], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [OriginalName], Source={x:Static app:Loc.Instance}}" />
                        <TextBox Text="{Binding Original, Mode=OneWay}" AutomationProperties.Name="{Binding [OriginalName], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [Destination], Source={x:Static app:Loc.Instance}}" />
                        <TextBox Text="{Binding Destination, Mode=OneWay}" AutomationProperties.Name="{Binding [Destination], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [ColSize], Source={x:Static app:Loc.Instance}}" />
                        <TextBox Text="{Binding SizeText, Mode=OneWay}" AutomationProperties.Name="{Binding [ColSize], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [ColStatus], Source={x:Static app:Loc.Instance}}" />
                        <TextBox Text="{Binding Status, Mode=OneWay}" AutomationProperties.Name="{Binding [ColStatus], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [Sha256], Source={x:Static app:Loc.Instance}}" />
                        <TextBox Text="{Binding Sha256, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" AutomationProperties.Name="{Binding [Sha256], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [LastError], Source={x:Static app:Loc.Instance}}" />
                        <TextBox Text="{Binding LastError, Mode=OneWay}" AutomationProperties.Name="{Binding [LastError], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding [HashNote], Source={x:Static app:Loc.Instance}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
