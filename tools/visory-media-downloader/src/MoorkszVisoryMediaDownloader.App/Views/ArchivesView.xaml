<UserControl x:Class="MoorkszVisoryMediaDownloader.App.Views.ArchivesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:MoorkszVisoryMediaDownloader.App">
    <Grid Margin="32,0,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [ArchiveScope], Source={x:Static app:Loc.Instance}}" />
                        <ComboBox Width="220" ItemsSource="{Binding ArchiveScopes}" SelectedItem="{Binding ArchiveScopeChoice}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="{Binding [ArchiveScope], Source={x:Static app:Loc.Instance}}" />
                    </StackPanel>
                    <Button Style="{StaticResource Button.Primary}" VerticalAlignment="Bottom" Margin="0,0,8,8" Command="{Binding CreateArchiveCommand}"
                            Content="{Binding [CreateArchive], Source={x:Static app:Loc.Instance}}" />
                    <Button Style="{DynamicResource Button.Secondary}" VerticalAlignment="Bottom" Margin="0,0,8,8" Command="{Binding VerifyArchiveCommand}"
                            Content="{Binding [VerifyArchive], Source={x:Static app:Loc.Instance}}" />
                    <Button Style="{DynamicResource Button.Secondary}" VerticalAlignment="Bottom" Margin="0,0,8,8" Command="{Binding BrowseArchiveCommand}"
                            Content="{Binding [BrowseContents], Source={x:Static app:Loc.Instance}}" />
                    <Button Style="{DynamicResource Button.Secondary}" VerticalAlignment="Bottom" Margin="0,0,8,8" Command="{Binding OpenArchiveFolderCommand}"
                            Content="{Binding [OpenFolder], Source={x:Static app:Loc.Instance}}" />
                </WrapPanel>
                <StackPanel Visibility="{Binding IsArchiving, Converter={StaticResource Visible}}" Margin="0,8,0,0">
                    <ProgressBar Style="{DynamicResource ProgressThin}" Value="{Binding ArchiveProgressPercent, Mode=OneWay}" AutomationProperties.Name="{Binding [StateArchiving], Source={x:Static app:Loc.Instance}}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" Text="{Binding ArchiveProgressText}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </StackPanel>
        </Border>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Archives}" SelectedItem="{Binding SelectedArchive}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None" AutomationProperties.Name="{Binding [NavArchives], Source={x:Static app:Loc.Instance}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding [ColCreated], Source={x:Static app:Loc.Instance}}" Binding="{Binding Created}" Width="140" />
                <DataGridTextColumn Header="{Binding [ColFile], Source={x:Static app:Loc.Instance}}" Binding="{Binding FileName}" Width="*" MinWidth="200" />
                <DataGridTextColumn Header="{Binding [ColScope], Source={x:Static app:Loc.Instance}}" Binding="{Binding Scope}" Width="150" />
                <DataGridTextColumn Header="{Binding [ColEntries], Source={x:Static app:Loc.Instance}}" Binding="{Binding Entries}" Width="70" />
                <DataGridTextColumn Header="{Binding [ColSize], Source={x:Static app:Loc.Instance}}" Binding="{Binding Size}" Width="90" />
                <DataGridTextColumn Header="{Binding [ColStatus], Source={x:Static app:Loc.Instance}}" Binding="{Binding Status}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Style="{StaticResource Text.Secondary}" Margin="0,10,0,0" Text="{Binding SelectedArchive.Message}" />
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Heading}" Text="{Binding [BrowseContents], Source={x:Static app:Loc.Instance}}" AutomationProperties.HeadingLevel="Level2" />
                <ListView ItemsSource="{Binding ArchiveEntries}" BorderThickness="0" Background="Transparent" VirtualizingPanel.IsVirtualizing="True"
                          AutomationProperties.Name="{Binding [BrowseContents], Source={x:Static app:Loc.Instance}}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" Text="{Binding Size}" />
                                <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
