<UserControl x:Class="MoorkszVisoryMediaDownloader.App.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:MoorkszVisoryMediaDownloader.App">
    <Grid Margin="32,0,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <Grid>
                        <ProgressBar Style="{DynamicResource ProgressThin}" Value="{Binding OverallPercent, Mode=OneWay}" Margin="0,0,64,0" VerticalAlignment="Center"
                                     AutomationProperties.Name="{Binding [OverallProgress], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding OverallPercent, StringFormat={}{0:0.0} %}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding [Completed], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" FontWeight="SemiBold" Margin="6,0,18,0" Text="{Binding CompletedCount}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding [Failed], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" FontWeight="SemiBold" Margin="6,0,18,0" Text="{Binding FailedCount}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding [Pending], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" FontWeight="SemiBold" Margin="6,0,18,0" Text="{Binding PendingCount}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding SpeedText}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Primary}" Margin="0,0,8,0" Command="{Binding StartBackupCommand}" Visibility="{Binding IsIdle, Converter={StaticResource Visible}}"
                            Content="{Binding [StartBackup], Source={x:Static app:Loc.Instance}}" />
                    <Button Style="{DynamicResource Button.Secondary}" Command="{Binding PauseResumeCommand}" Content="{Binding PauseResumeText}" />
                    <Button Style="{DynamicResource Button.Secondary}" Margin="0" Command="{Binding StopCommand}" Content="{Binding [Stop], Source={x:Static app:Loc.Instance}}" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Style="{StaticResource Text.Secondary}" Text="{Binding [QueueEmpty], Source={x:Static app:Loc.Instance}}"
                   Visibility="{Binding HasTransfers, Converter={StaticResource Hidden}}" />
        <ListView Grid.Row="1" ItemsSource="{Binding Transfers}" Visibility="{Binding HasTransfers, Converter={StaticResource Visible}}"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" BorderThickness="0" Background="Transparent"
                  HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding [NavDownloads], Source={x:Static app:Loc.Instance}}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <ProgressBar Style="{DynamicResource ProgressThin}" Margin="0,8,0,6" Value="{Binding Percent, Mode=OneWay}" AutomationProperties.Name="{Binding FileName}" />
                                <WrapPanel>
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Status}" Margin="0,0,12,0" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Engine}" Margin="0,0,12,0" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Attempt}" Margin="0,0,12,0" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Bytes}" Margin="0,0,12,0" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Speed}" Margin="0,0,12,0" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Elapsed}" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{DynamicResource Button.Secondary}" Command="{Binding DataContext.RetryNowCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding Key}"
                                        Visibility="{Binding WaitingForRetry, Converter={StaticResource Visible}}" Content="{Binding [RetryNow], Source={x:Static app:Loc.Instance}}" />
                                <Button Style="{DynamicResource Button.Secondary}" Margin="0" Command="{Binding DataContext.CancelItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding Key}"
                                        Content="{Binding [Cancel], Source={x:Static app:Loc.Instance}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
