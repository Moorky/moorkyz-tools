<UserControl x:Class="MoorkszVisoryMediaDownloader.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:MoorkszVisoryMediaDownloader.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,0,32,32">

            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="24" Visibility="{Binding ShowWelcome, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Title}" FontSize="20" Text="{Binding [WelcomeTitle], Source={x:Static app:Loc.Instance}}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,16" MaxWidth="640" HorizontalAlignment="Left" Text="{Binding [WelcomeText], Source={x:Static app:Loc.Instance}}" />
                    <WrapPanel>
                        <Button Style="{StaticResource Button.Primary}" Margin="0,0,8,8" Command="{Binding SignInScanCommand}" Content="{Binding [SignInScan], Source={x:Static app:Loc.Instance}}" />
                        <Button Style="{DynamicResource Button.Secondary}" Margin="0,0,8,8" Command="{Binding DemoCommand}" Content="{Binding DemoButtonText}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" Text="{Binding [DataNote], Source={x:Static app:Loc.Instance}}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Foreground="{DynamicResource Brush.Accent}" Text="{Binding ScanProgressText}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasInventory, Converter={StaticResource Visible}}">
                <WrapPanel Margin="0,0,-12,0">
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding RecordingsLabel}" />
                            <TextBlock Style="{StaticResource Text.Stat}" Text="{Binding RecordingsCount}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [Completed], Source={x:Static app:Loc.Instance}}" />
                            <TextBlock Style="{StaticResource Text.Stat}" Foreground="{DynamicResource Brush.Success}" Text="{Binding CompletedCount}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [Failed], Source={x:Static app:Loc.Instance}}" />
                            <TextBlock Style="{StaticResource Text.Stat}" Foreground="{DynamicResource Brush.Danger}" Text="{Binding FailedCount}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [Pending], Source={x:Static app:Loc.Instance}}" />
                            <TextBlock Style="{StaticResource Text.Stat}" Text="{Binding PendingCount}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [Downloaded], Source={x:Static app:Loc.Instance}}" />
                            <TextBlock Style="{StaticResource Text.Stat}" Text="{Binding DownloadedText}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16" Background="{DynamicResource Brush.WarningSubtle}" BorderBrush="{DynamicResource Brush.Warning}"
                        Visibility="{Binding CompletenessWarning, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}" Text="{Binding [IncompleteWarning], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" Text="{Binding InventoryNotes}" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Heading}" Text="{Binding [OverallProgress], Source={x:Static app:Loc.Instance}}" AutomationProperties.HeadingLevel="Level2" />
                            <Grid>
                                <ProgressBar Style="{DynamicResource ProgressThin}" Value="{Binding OverallPercent, Mode=OneWay}" Margin="0,0,56,0" VerticalAlignment="Center"
                                             AutomationProperties.Name="{Binding [OverallProgress], Source={x:Static app:Loc.Instance}}" />
                                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding OverallPercent, StringFormat={}{0:0.0} %}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Text.Label}" Margin="0,18,0,4" Text="{Binding [CurrentFile], Source={x:Static app:Loc.Instance}}" />
                            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding CurrentFile}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <ProgressBar Style="{DynamicResource ProgressThin}" Margin="0,8,0,0" Value="{Binding CurrentFilePercent, Mode=OneWay}"
                                         AutomationProperties.Name="{Binding [CurrentFile], Source={x:Static app:Loc.Instance}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
                                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding SpeedText}" />
                                <TextBlock Style="{StaticResource Text.Secondary}" Text="  •  " />
                                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding BytesText}" />
                                <TextBlock Style="{StaticResource Text.Secondary}" Text="  •  " />
                                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding [Eta], Source={x:Static app:Loc.Instance}}" />
                                <TextBlock Style="{StaticResource Text.Secondary}" Text=" " />
                                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding EtaText}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" Text="{Binding ArchiveProgressText}" Visibility="{Binding IsArchiving, Converter={StaticResource Visible}}" />
                            <WrapPanel Margin="0,18,0,0">
                                <Button Style="{StaticResource Button.Primary}" Margin="0,0,8,8" Command="{Binding StartBackupCommand}" Visibility="{Binding IsIdle, Converter={StaticResource Visible}}"
                                        Content="{Binding [StartBackup], Source={x:Static app:Loc.Instance}}" />
                                <Button Style="{DynamicResource Button.Secondary}" Margin="0,0,8,8" Command="{Binding ResumeRunCommand}" Visibility="{Binding HasInterruptedRun, Converter={StaticResource Visible}}"
                                        Content="{Binding [ResumeRun], Source={x:Static app:Loc.Instance}}" />
                                <Button Style="{DynamicResource Button.Secondary}" Margin="0,0,8,8" Command="{Binding PauseResumeCommand}" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}"
                                        Content="{Binding PauseResumeText}" />
                                <Button Style="{DynamicResource Button.Secondary}" Margin="0,0,8,8" Command="{Binding StopCommand}" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}"
                                        Content="{Binding [Stop], Source={x:Static app:Loc.Instance}}" />
                                <Button Style="{DynamicResource Button.Secondary}" Margin="0,0,8,8" Command="{Binding SignInScanCommand}"
                                        Content="{Binding [SignInScan], Source={x:Static app:Loc.Instance}}" />
                                <Button Style="{DynamicResource Button.Secondary}" Margin="0,0,8,8" Command="{Binding OpenDownloadsCommand}"
                                        Content="{Binding [OpenDownloads], Source={x:Static app:Loc.Instance}}" />
                                <Button Style="{DynamicResource Button.Secondary}" Margin="0,0,8,8" Command="{Binding ViewReportsCommand}"
                                        Content="{Binding [ViewReports], Source={x:Static app:Loc.Instance}}" />
                                <Button Style="{DynamicResource Button.Secondary}" Margin="0,0,8,8" Command="{Binding DemoCommand}" Visibility="{Binding IsDemo, Converter={StaticResource Visible}}"
                                        Content="{Binding DemoButtonText}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Accent}" Text="{Binding ScanProgressText}" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                    <Setter Property="Margin" Value="0,3" />
                                </Style>
                            </Grid.Resources>
                            <TextBlock Grid.ColumnSpan="2" Style="{StaticResource Text.Heading}" Text="{Binding [Inventory], Source={x:Static app:Loc.Instance}}" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Grid.Row="1" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding [ScanCompleteness], Source={x:Static app:Loc.Instance}}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Text="{Binding CompletenessText}" />
                            <TextBlock Grid.Row="2" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding [Cameras], Source={x:Static app:Loc.Instance}}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Text="{Binding CamerasCount}" />
                            <TextBlock Grid.Row="3" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding [SelectedForBackup], Source={x:Static app:Loc.Instance}}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" FontWeight="SemiBold" Text="{Binding SelectedCount}" />
                            <TextBlock Grid.Row="4" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding [AlreadyVerified], Source={x:Static app:Loc.Instance}}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" FontWeight="SemiBold" Text="{Binding VerifiedCount}" />
                            <TextBlock Grid.Row="5" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding [NeedDownload], Source={x:Static app:Loc.Instance}}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" FontWeight="SemiBold" Text="{Binding NeedDownloadCount}" />
                            <TextBlock Grid.Row="6" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding [Missing], Source={x:Static app:Loc.Instance}}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" FontWeight="SemiBold" Text="{Binding MissingCount}" />
                            <TextBlock Grid.Row="7" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding [Corrupt], Source={x:Static app:Loc.Instance}}" />
                            <TextBlock Grid.Row="7" Grid.Column="1" FontWeight="SemiBold" Text="{Binding CorruptCount}" />
                            <TextBlock Grid.Row="8" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding [NeedsRetry], Source={x:Static app:Loc.Instance}}" />
                            <TextBlock Grid.Row="8" Grid.Column="1" FontWeight="SemiBold" Text="{Binding NeedsRetryCount}" />
                            <TextBlock Grid.Row="9" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding [EstimatedSize], Source={x:Static app:Loc.Instance}}" />
                            <TextBlock Grid.Row="9" Grid.Column="1" FontWeight="SemiBold" TextAlignment="Right" MaxWidth="180" Text="{Binding EstimatedSizeText}" />
                            <TextBlock Grid.Row="10" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding [FreeSpace], Source={x:Static app:Loc.Instance}}" />
                            <TextBlock Grid.Row="10" Grid.Column="1" FontWeight="SemiBold" Text="{Binding FreeSpaceText}" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding HasLastSummary, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Heading}" Text="{Binding [LastRun], Source={x:Static app:Loc.Instance}}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding LastSummaryText}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" Text="{Binding LastScanText, StringFormat={}• {0}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Heading}" Text="{Binding [RecentActivity], Source={x:Static app:Loc.Instance}}" AutomationProperties.HeadingLevel="Level2" />
                        <ItemsControl ItemsSource="{Binding Activity}" MaxHeight="320" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" Focusable="False">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Text.Mono}" Foreground="{DynamicResource Brush.TextTertiary}" Text="{Binding Time}" />
                                        <TextBlock Grid.Column="1" x:Name="Level" Style="{StaticResource Text.Mono}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Level}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Text.Mono}" Text="{Binding Text}" TextWrapping="Wrap" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="SUCCESS">
                                            <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="FAIL">
                                            <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="WARN">
                                            <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="RETRY">
                                            <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
