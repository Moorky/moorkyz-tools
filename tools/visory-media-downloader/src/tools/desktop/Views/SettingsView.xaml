<UserControl x:Class="MoorkszVisoryMediaDownloader.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:MoorkszVisoryMediaDownloader.App">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="32,0,32,24" MaxWidth="820" HorizontalAlignment="Left">
                <StackPanel.Resources>
                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </Style>
                </StackPanel.Resources>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Heading}" Text="{Binding [SettingsStorage], Source={x:Static app:Loc.Instance}}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [OutputFolder], Source={x:Static app:Loc.Instance}}" />
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Style="{DynamicResource Button.Secondary}" Margin="8,0,0,0" Command="{Binding BrowseOutputCommand}" Content="{Binding [Browse], Source={x:Static app:Loc.Instance}}" />
                            <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding [OutputFolder], Source={x:Static app:Loc.Instance}}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [DataLocation], Source={x:Static app:Loc.Instance}}" />
                        <TextBox Text="{Binding DataLocationText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.Name="{Binding [DataLocation], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [SessionLocation], Source={x:Static app:Loc.Instance}}" />
                        <TextBox Text="{Binding SessionLocationText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="{Binding [SessionLocation], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" Text="{Binding [SessionNote], Source={x:Static app:Loc.Instance}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Heading}" Text="{Binding [SettingsFilters], Source={x:Static app:Loc.Instance}}" AutomationProperties.HeadingLevel="Level2" />
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,12">
                                <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [StartDate], Source={x:Static app:Loc.Instance}}" />
                                <DatePicker Width="180" SelectedDate="{Binding StartDate}" AutomationProperties.Name="{Binding [StartDate], Source={x:Static app:Loc.Instance}}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,12">
                                <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [EndDate], Source={x:Static app:Loc.Instance}}" />
                                <DatePicker Width="180" SelectedDate="{Binding EndDate}" AutomationProperties.Name="{Binding [EndDate], Source={x:Static app:Loc.Instance}}" />
                            </StackPanel>
                        </WrapPanel>
                        <CheckBox IsChecked="{Binding IncludeUnknownDates}" Content="{Binding [IncludeUnknownDates], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [CamerasFilterHint], Source={x:Static app:Loc.Instance}}" />
                        <TextBox Text="{Binding CamerasText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" AutomationProperties.Name="{Binding [CamerasFilterHint], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [TypesFilterHint], Source={x:Static app:Loc.Instance}}" />
                        <TextBox Text="{Binding TypesText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" AutomationProperties.Name="{Binding [TypesFilterHint], Source={x:Static app:Loc.Instance}}" />
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,12">
                                <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [MinSizeMb], Source={x:Static app:Loc.Instance}}" />
                                <TextBox Width="140" Text="{Binding MinSizeText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding [MinSizeMb], Source={x:Static app:Loc.Instance}}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,12">
                                <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [MaxSizeMb], Source={x:Static app:Loc.Instance}}" />
                                <TextBox Width="140" Text="{Binding MaxSizeText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding [MaxSizeMb], Source={x:Static app:Loc.Instance}}" />
                            </StackPanel>
                        </WrapPanel>
                        <CheckBox IsChecked="{Binding NewOrMissingOnly}" Content="{Binding [NewOrMissingOnly], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Text.Label}" Margin="0,6,0,4" Text="{Binding [SettingsNaming], Source={x:Static app:Loc.Instance}}" />
                        <ComboBox Width="280" HorizontalAlignment="Left" ItemsSource="{Binding NamingChoices}" SelectedItem="{Binding Naming}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="{Binding [SettingsNaming], Source={x:Static app:Loc.Instance}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Heading}" Text="{Binding [SettingsDownloads], Source={x:Static app:Loc.Instance}}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [PriorityMode], Source={x:Static app:Loc.Instance}}" />
                        <ComboBox Width="280" HorizontalAlignment="Left" Margin="0,0,0,12" ItemsSource="{Binding PriorityChoices}" SelectedItem="{Binding Priority}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="{Binding [PriorityMode], Source={x:Static app:Loc.Instance}}" />
                        <CheckBox IsChecked="{Binding UseBits}" Content="{Binding [UseBits], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,-4,0,12" Text="{Binding [BitsNote], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [Integrity], Source={x:Static app:Loc.Instance}}" />
                        <ComboBox Width="280" HorizontalAlignment="Left" Margin="0,0,0,12" ItemsSource="{Binding IntegrityChoices}" SelectedItem="{Binding Integrity}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="{Binding [Integrity], Source={x:Static app:Loc.Instance}}" />
                        <Expander Header="{Binding [Advanced], Source={x:Static app:Loc.Instance}}">
                            <WrapPanel Margin="0,10,0,0">
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [Concurrency], Source={x:Static app:Loc.Instance}}" />
                                    <TextBox Width="120" Text="{Binding Concurrency, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding [Concurrency], Source={x:Static app:Loc.Instance}}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [Bandwidth], Source={x:Static app:Loc.Instance}}" />
                                    <TextBox Width="120" Text="{Binding Bandwidth, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding [Bandwidth], Source={x:Static app:Loc.Instance}}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [Retries], Source={x:Static app:Loc.Instance}}" />
                                    <TextBox Width="120" Text="{Binding Attempts, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding [Retries], Source={x:Static app:Loc.Instance}}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [Timeout], Source={x:Static app:Loc.Instance}}" />
                                    <TextBox Width="120" Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding [Timeout], Source={x:Static app:Loc.Instance}}" />
                                </StackPanel>
                            </WrapPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Heading}" Text="{Binding [SettingsArchive], Source={x:Static app:Loc.Instance}}" AutomationProperties.HeadingLevel="Level2" />
                        <CheckBox IsChecked="{Binding AutoArchive}" Content="{Binding [AutoArchive], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [ArchiveScope], Source={x:Static app:Loc.Instance}}" />
                        <ComboBox Width="280" HorizontalAlignment="Left" ItemsSource="{Binding ArchiveScopes}" SelectedItem="{Binding SettingsArchiveScope}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="{Binding [ArchiveScope], Source={x:Static app:Loc.Instance}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Heading}" Text="{Binding [SettingsBackground], Source={x:Static app:Loc.Instance}}" AutomationProperties.HeadingLevel="Level2" />
                        <CheckBox IsChecked="{Binding MinimizeToTray}" Content="{Binding [MinimizeToTray], Source={x:Static app:Loc.Instance}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox IsChecked="{Binding ScheduleEnabled}" Margin="0" VerticalAlignment="Center" Content="{Binding [ScheduleDaily], Source={x:Static app:Loc.Instance}}" />
                            <TextBox Width="80" Margin="10,0,0,0" Text="{Binding ScheduleTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding [ScheduleDaily], Source={x:Static app:Loc.Instance}}" />
                        </StackPanel>
                        <CheckBox IsChecked="{Binding RunAfterLogin}" Content="{Binding [RunAfterLogin], Source={x:Static app:Loc.Instance}}" />
                        <CheckBox IsChecked="{Binding NotifyOnCompletion}" Content="{Binding [Notify], Source={x:Static app:Loc.Instance}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Heading}" Text="{Binding [SettingsAppearance], Source={x:Static app:Loc.Instance}}" AutomationProperties.HeadingLevel="Level2" />
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,12">
                                <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [Theme], Source={x:Static app:Loc.Instance}}" />
                                <ComboBox Width="200" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding Theme}" DisplayMemberPath="Label" AutomationProperties.Name="{Binding [Theme], Source={x:Static app:Loc.Instance}}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,12">
                                <TextBlock Style="{StaticResource Text.Label}" Text="{Binding [Language], Source={x:Static app:Loc.Instance}}" />
                                <ComboBox Width="200" ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding Language}" DisplayMemberPath="Label" AutomationProperties.Name="{Binding [Language], Source={x:Static app:Loc.Instance}}" />
                            </StackPanel>
                        </WrapPanel>
                        <CheckBox IsChecked="{Binding ReduceMotion}" Content="{Binding [ReduceMotion], Source={x:Static app:Loc.Instance}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Heading}" Text="{Binding [SettingsPrivacy], Source={x:Static app:Loc.Instance}}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,12" Text="{Binding [UrlsRedacted], Source={x:Static app:Loc.Instance}}" />
                        <CheckBox IsChecked="{Binding DiagnosticsEnabled}" Content="{Binding [Diagnostics], Source={x:Static app:Loc.Instance}}" />
                        <WrapPanel>
                            <Button Style="{DynamicResource Button.Secondary}" Margin="0,0,8,8" Command="{Binding SignOutCommand}" Content="{Binding [SignOut], Source={x:Static app:Loc.Instance}}" />
                            <Button Style="{DynamicResource Button.Secondary}" Margin="0,0,8,8" Command="{Binding DeleteSessionCommand}" Content="{Binding [DeleteSession], Source={x:Static app:Loc.Instance}}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding [DataNote], Source={x:Static app:Loc.Instance}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="0,1,0,0" Padding="32,12">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource Button.Primary}" Command="{Binding SaveSettingsCommand}" Content="{Binding [SaveSettings], Source={x:Static app:Loc.Instance}}" />
                <TextBlock Style="{StaticResource Text.Secondary}" Margin="16,0,0,0" VerticalAlignment="Center" Text="{Binding SettingsMessage}" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
