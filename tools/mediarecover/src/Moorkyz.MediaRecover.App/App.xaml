<Application x:Class="Moorkyz.Tools.MediaRecover.App.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Surface" Color="#FAFAFC"/>
  <SolidColorBrush x:Key="Ink" Color="#202332"/>
  <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Line" Color="#D5D8E1"/>
  <Style TargetType="Window"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="Control"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style TargetType="Button">
   <Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Padding" Value="14,8"/><Setter Property="MinHeight" Value="36"/>
   <Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="0,4,8,8"/><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4,8,8"/><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7,12,7"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,8,0,8"/><Setter Property="Padding" Value="12"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="22,12"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Panel}"/></Style>
  <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
 </Application.Resources>
</Application>
