<Window x:Class="Moorkyz.Tools.MediaRecover.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Moorkyz Media Recover" Width="1120" Height="860" MinWidth="800" MinHeight="600"
 WindowStartupLocation="CenterScreen" Closing="OnClosing" Closed="OnClosed">
 <DockPanel Margin="26">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="MOORKYZ TOOLS · LOCAL MEDIA RECOVERY" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock Text="Moorkyz Media Recover" FontSize="30" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding T[Tagline]}" Margin="0,6,0,0"/>
   </StackPanel>
   <Button Grid.Column="1" Content="{Binding T[Help]}" Command="{Binding Help}" VerticalAlignment="Top"/>
  </Grid>
  <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
   <StackPanel>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxHeight="75" AutomationProperties.LiveSetting="Polite"/>
    <Border Height="3" Margin="0,10,0,0" Background="{DynamicResource Line}" Visibility="{Binding Busy, Converter={StaticResource BooleanVisibility}}"/>
   </StackPanel>
  </Border>
  <TabControl SelectedIndex="{Binding SelectedTab}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}">
   <TabItem Header="{Binding T[Overview]}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
     <StackPanel>
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="15" Margin="0,0,0,10" Visibility="{Binding ShowIntro, Converter={StaticResource BooleanVisibility}}">
       <StackPanel><TextBlock Text="{Binding T[Intro]}" TextWrapping="Wrap" LineHeight="23"/><Button Content="{Binding T[GotIt]}" Command="{Binding DismissIntro}" HorizontalAlignment="Left"/></StackPanel>
      </Border>
      <GroupBox Header="{Binding T[Sources]}">
       <StackPanel>
        <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Height="88" Background="{DynamicResource Panel}" Foreground="{DynamicResource Ink}" AutomationProperties.Name="{Binding T[Sources]}">
         <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Kind}" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBlock Text="{Binding Id}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel><Button Content="{Binding T[AddFolder]}" Command="{Binding AddFolder}"/><Button Content="{Binding T[Remove]}" Command="{Binding RemoveSource}"/><Button Content="{Binding T[Detect]}" Command="{Binding DetectDevices}"/></WrapPanel>
        <DockPanel>
         <Button DockPanel.Dock="Right" Content="{Binding T[AddDevice]}" Command="{Binding AddDevice}"/>
         <ComboBox ItemsSource="{Binding Devices}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedDevice}" AutomationProperties.Name="{Binding T[Detect]}"/>
        </DockPanel>
        <TextBlock Text="{Binding T[DeviceHelp]}" TextWrapping="Wrap" FontSize="12"/>
       </StackPanel>
      </GroupBox>
      <GroupBox Header="{Binding T[Destination]}">
       <DockPanel IsEnabled="{Binding Idle}">
        <Button DockPanel.Dock="Right" Content="{Binding T[Browse]}" Command="{Binding BrowseDestination}"/>
        <TextBox Text="{Binding Settings.Destination, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{Binding T[Destination]}"/>
       </DockPanel>
      </GroupBox>
      <WrapPanel>
       <Button Content="{Binding T[Scan]}" Command="{Binding Scan}" FontWeight="SemiBold"/>
       <Button Content="{Binding T[Recover]}" Command="{Binding Recover}" FontWeight="SemiBold"/>
       <Button Content="{Binding T[Pause]}" Command="{Binding Pause}"/><Button Content="{Binding T[Resume]}" Command="{Binding Resume}"/>
       <Button Content="{Binding T[Stop]}" Command="{Binding Stop}"/>
      </WrapPanel>
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,12,0,12" LineHeight="23"/>
      <TextBlock Text="{Binding T[SavedTo]}" FontWeight="SemiBold"/>
      <TextBox Text="{Binding SavedPath, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="{Binding T[SavedTo]}"/>
      <WrapPanel><Button Content="{Binding T[OpenFolder]}" Command="{Binding OpenFolder}"/><Button Content="{Binding T[CopyPath]}" Command="{Binding CopyPath}"/><Button Content="{Binding T[Reports]}" Command="{Binding OpenReports}"/><Button Content="{Binding T[Failures]}" Command="{Binding ViewFailures}"/><Button Content="{Binding T[Verify]}" Command="{Binding Verify}"/><Button Content="{Binding T[Archive]}" Command="{Binding OpenArchive}"/></WrapPanel>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="{Binding T[Activity]}">
    <DockPanel Margin="16">
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding T[Search]}"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding T[Search]}"/><TextBlock Text="{Binding T[Bounded]}" Margin="0,0,0,12" TextWrapping="Wrap"/></StackPanel>
     <StackPanel DockPanel.Dock="Bottom"><TextBox Text="{Binding SelectedLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Selected activity details"/><Button Content="{Binding T[Retry]}" Command="{Binding Retry}" HorizontalAlignment="Left"/></StackPanel>
     <ListBox ItemsSource="{Binding LogsView}" SelectedItem="{Binding SelectedLog}" Background="{DynamicResource Panel}" Foreground="{DynamicResource Ink}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding T[Activity]}">
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="2,5"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </TabItem>
   <TabItem Header="{Binding T[History]}">
    <DockPanel Margin="16">
     <TextBlock DockPanel.Dock="Top" Text="{Binding T[EmptyHistory]}" Margin="0,0,0,12" TextWrapping="Wrap"/>
     <WrapPanel DockPanel.Dock="Bottom"><Button Content="{Binding T[Retry]}" Command="{Binding Retry}"/><Button Content="{Binding T[Reports]}" Command="{Binding OpenReports}"/><Button Content="{Binding T[Failures]}" Command="{Binding ViewFailures}"/><Button Content="{Binding T[Verify]}" Command="{Binding Verify}"/><Button Content="{Binding T[Archive]}" Command="{Binding OpenArchive}"/></WrapPanel>
     <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedRun}" Background="{DynamicResource Panel}" Foreground="{DynamicResource Ink}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding T[History]}">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8">
       <TextBlock Text="{Binding Id}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}"/>
       <TextBlock><TextBlock.Text><MultiBinding StringFormat="Video: {0} | Audio: {1} | Found: {2}"><Binding Path="Video"/><Binding Path="Audio"/><Binding Path="Discovered"/></MultiBinding></TextBlock.Text></TextBlock>
       <ItemsControl ItemsSource="{Binding Settings.Sources}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Id}" TextWrapping="Wrap" FontSize="12"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <TextBlock Text="{Binding Settings.Destination}" TextWrapping="Wrap"/><TextBlock Text="{Binding Reports}" TextWrapping="Wrap" FontSize="12"/>
      </StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </TabItem>
   <TabItem Header="{Binding T[Settings]}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
     <StackPanel IsEnabled="{Binding Idle}">
      <GroupBox Header="{Binding T[Filters]}"><StackPanel>
       <WrapPanel><CheckBox Content="{Binding T[Videos]}" IsChecked="{Binding Settings.Videos}"/><CheckBox Content="{Binding T[Audio]}" IsChecked="{Binding Settings.Audio}"/><CheckBox Content="{Binding T[Hidden]}" IsChecked="{Binding Settings.IncludeHidden}"/></WrapPanel>
       <CheckBox Content="{Binding T[DateFilter]}" IsChecked="{Binding Settings.DateFilter}"/>
       <WrapPanel>
        <StackPanel Margin="0,0,20,0"><TextBlock Text="{Binding T[StartDate]}"/><DatePicker SelectedDate="{Binding Settings.StartDate}" Margin="0,6" AutomationProperties.Name="{Binding T[StartDate]}"/></StackPanel>
        <StackPanel><TextBlock Text="{Binding T[EndDate]}"/><DatePicker SelectedDate="{Binding Settings.EndDate}" Margin="0,6" AutomationProperties.Name="{Binding T[EndDate]}"/></StackPanel>
       </WrapPanel>
       <CheckBox Content="{Binding T[Unknown]}" IsChecked="{Binding Settings.IncludeUnknown}"/>
       <TextBlock Text="{Binding T[DateHelp]}" TextWrapping="Wrap" FontSize="12"/>
      </StackPanel></GroupBox>
      <GroupBox Header="{Binding T[Destination]}"><StackPanel>
       <DockPanel><Button DockPanel.Dock="Right" Content="{Binding T[Browse]}" Command="{Binding BrowseDestination}"/><TextBox Text="{Binding Settings.Destination, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{Binding T[Destination]}"/></DockPanel>
       <TextBlock Text="{Binding T[Layout]}"/><ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding Settings.Layout}" AutomationProperties.Name="{Binding T[Layout]}"/>
      </StackPanel></GroupBox>
      <GroupBox Header="{Binding T[Reliability]}"><StackPanel>
       <CheckBox Content="{Binding T[Assurance]}" IsChecked="{Binding Settings.HighAssurance}" ToolTip="{Binding T[Assurance]}"/>
       <CheckBox Content="{Binding T[Retries]}" IsChecked="{Binding Settings.Retry}"/>
       <CheckBox Content="{Binding T[Zip]}" IsChecked="{Binding Settings.Zip}"/>
       <WrapPanel><Button Content="{Binding T[Verify]}" Command="{Binding Verify}"/><Button Content="{Binding T[Legacy]}" Command="{Binding ImportLegacy}"/></WrapPanel>
      </StackPanel></GroupBox>
      <Expander Header="{Binding T[Advanced]}" Margin="0,12"><StackPanel Margin="10">
       <TextBlock Text="{Binding T[Extensions]}"/><TextBox Text="{Binding Settings.Extensions}" TextWrapping="Wrap" ToolTip="{Binding T[Extensions]}" AutomationProperties.Name="{Binding T[Extensions]}"/>
       <CheckBox Content="{Binding T[AllTypes]}" IsChecked="{Binding Settings.AllTypes}"/>
       <TextBlock Text="{Binding T[Exclusions]}"/><TextBox Text="{Binding Settings.Exclusions}" AutomationProperties.Name="{Binding T[Exclusions]}"/>
       <TextBlock Text="{Binding T[Speed]}"/><TextBox Text="{Binding Settings.SpeedLimitBytes, ValidatesOnExceptions=True}" AutomationProperties.Name="{Binding T[Speed]}"/>
      </StackPanel></Expander>
      <GroupBox Header="{Binding T[Appearance]}"><StackPanel>
       <TextBlock Text="{Binding T[Language]}"/><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Settings.Language}" AutomationProperties.Name="{Binding T[Language]}"/>
       <TextBlock Text="{Binding T[Theme]}"/><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Settings.Theme}" AutomationProperties.Name="{Binding T[Theme]}"/>
       <WrapPanel><Button Content="{Binding T[Save]}" Command="{Binding SaveSettings}"/><Button Content="{Binding T[Reset]}" Command="{Binding ResetSettings}"/><Button Content="{Binding T[Diagnostics]}" Command="{Binding Diagnostics}"/><Button Content="{Binding T[OpenState]}" Command="{Binding OpenState}"/></WrapPanel>
      </StackPanel></GroupBox>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
