<Window x:Class="VisoryBulkDownloader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:VisoryBulkDownloader.App"
        xmlns:views="clr-namespace:VisoryBulkDownloader.App.Views"
        Title="{Binding [AppName], Source={x:Static app:Loc.Instance}}"
        Width="1220" Height="800" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13.5"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="ProgressThin" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        </Style>
        <Style x:Key="CompactItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="0" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="1" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="2" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="3" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="4" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="5" />
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">
                <Grid DockPanel.Dock="Top" Margin="6,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="/app.ico" Width="30" Height="30" VerticalAlignment="Top" Margin="0,2,0,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [AppName], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="{Binding [AppTagline], Source={x:Static app:Loc.Instance}}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </Grid>
                <StackPanel DockPanel.Dock="Bottom" Margin="6,12,6,0">
                    <Border CornerRadius="8" Padding="10,6" Background="{DynamicResource Brush.WarningSubtle}" Margin="0,0,0,10"
                            Visibility="{Binding IsDemo, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding [DemoBadge], Source={x:Static app:Loc.Instance}}" Foreground="{DynamicResource Brush.Warning}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="{Binding [Unofficial], Source={x:Static app:Loc.Instance}}" Style="{StaticResource Text.Caption}" />
                </StackPanel>
                <ListBox x:Name="Navigation" ItemsSource="{Binding Pages}" SelectedIndex="{Binding SelectedPage}" ItemContainerStyle="{StaticResource NavItem}"
                         Background="Transparent" BorderThickness="0" Padding="0" KeyboardNavigation.TabNavigation="Once"
                         AutomationProperties.Name="{Binding [NavDashboard], Source={x:Static app:Loc.Instance}}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding Glyph}" Width="20" FontSize="15" VerticalAlignment="Center" AutomationProperties.Name="" />
                                <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13.5" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="32,22,32,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Text.Title}" AutomationProperties.HeadingLevel="Level1" />
                <Border Grid.Column="1" Style="{StaticResource Pill}" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush, Converter={StaticResource PaletteBrush}}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="12.5" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="1" Margin="32,0,32,12" CornerRadius="8" Padding="14,10" BorderThickness="1"
                    Visibility="{Binding HasBanner, Converter={StaticResource Visible}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BannerIsError}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Command="{Binding DismissBannerCommand}" VerticalAlignment="Top" Margin="12,0,0,0"
                            Content="{Binding [Dismiss], Source={x:Static app:Loc.Instance}}" />
                    <TextBlock Text="{Binding Banner}" Style="{StaticResource Text.Body}" AutomationProperties.LiveSetting="Assertive" />
                </DockPanel>
            </Border>
            <Grid x:Name="PageHost" Grid.Row="2">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="PageOffset" />
                </Grid.RenderTransform>
                <views:DashboardView Visibility="{Binding SelectedPage, Converter={StaticResource PageVisible}, ConverterParameter=0}" />
                <views:RecordingsView Visibility="{Binding SelectedPage, Converter={StaticResource PageVisible}, ConverterParameter=1}" />
                <views:DownloadsView Visibility="{Binding SelectedPage, Converter={StaticResource PageVisible}, ConverterParameter=2}" />
                <views:ArchivesView Visibility="{Binding SelectedPage, Converter={StaticResource PageVisible}, ConverterParameter=3}" />
                <views:ReportsView Visibility="{Binding SelectedPage, Converter={StaticResource PageVisible}, ConverterParameter=4}" />
                <views:SettingsView Visibility="{Binding SelectedPage, Converter={StaticResource PageVisible}, ConverterParameter=5}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
