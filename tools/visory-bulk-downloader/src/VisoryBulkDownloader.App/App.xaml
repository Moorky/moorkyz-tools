<Application x:Class="VisoryBulkDownloader.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:VisoryBulkDownloader.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VisoryBulkDownloader;component/Themes/Palette.Light.xaml" />
                <ResourceDictionary Source="/VisoryBulkDownloader;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <app:BoolToVisibilityConverter x:Key="Visible" />
            <app:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
            <app:PageVisibilityConverter x:Key="PageVisible" />
            <app:ResourceBrushConverter x:Key="PaletteBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
