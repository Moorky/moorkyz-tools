<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Brush.Window" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.Card" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{x:Static SystemColors.HotTrackColor}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.SuccessSubtle" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.WarningSubtle" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.DangerSubtle" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.NavHover" Color="{x:Static SystemColors.HotTrackColor}" />
    <SolidColorBrush x:Key="Brush.NavSelected" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.Divider" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.Track" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Brush.Focus" Color="{x:Static SystemColors.HighlightColor}" />
</ResourceDictionary>
