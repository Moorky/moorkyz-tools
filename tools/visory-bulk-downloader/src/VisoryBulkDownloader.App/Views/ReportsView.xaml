<UserControl x:Class="VisoryBulkDownloader.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:VisoryBulkDownloader.App">
    <Grid Margin="32,0,32,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Heading}" Margin="10,6,0,8" Text="{Binding [Runs], Source={x:Static app:Loc.Instance}}" AutomationProperties.HeadingLevel="Level2" />
                <ListBox ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource NavItem}"
                         VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="{Binding [Runs], Source={x:Static app:Loc.Instance}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel AutomationProperties.Name="{Binding Id}">
                                <TextBlock Text="{Binding Id}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding State}" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Counts}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <TextBlock Grid.Column="2" Style="{StaticResource Text.Secondary}" Text="{Binding [SelectRunHint], Source={x:Static app:Loc.Instance}}"
                   Visibility="{Binding HasSelectedRun, Converter={StaticResource Hidden}}" />
        <Grid Grid.Column="2" Visibility="{Binding HasSelectedRun, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Heading}" Text="{Binding [Summary], Source={x:Static app:Loc.Instance}}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding RunSummaryText}" />
                </StackPanel>
            </Border>
            <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                <ComboBox Width="200" Margin="0,0,8,8" ItemsSource="{Binding LogFilters}" SelectedItem="{Binding LogFilter}" DisplayMemberPath="Label"
                          AutomationProperties.Name="{Binding [Log], Source={x:Static app:Loc.Instance}}" />
                <Button Style="{DynamicResource Button.Secondary}" Margin="0,0,8,8" Command="{Binding RetryFailedCommand}" Content="{Binding [RetryFailed], Source={x:Static app:Loc.Instance}}" />
                <Button Style="{DynamicResource Button.Secondary}" Margin="0,0,8,8" Command="{Binding ExportCsvCommand}" Content="{Binding [ExportCsv], Source={x:Static app:Loc.Instance}}" />
                <Button Style="{DynamicResource Button.Secondary}" Margin="0,0,8,8" Command="{Binding ExportJsonCommand}" Content="{Binding [ExportJson], Source={x:Static app:Loc.Instance}}" />
                <Button Style="{DynamicResource Button.Secondary}" Margin="0,0,8,8" Command="{Binding OpenReportFolderCommand}" Content="{Binding [OpenReportFolder], Source={x:Static app:Loc.Instance}}" />
            </WrapPanel>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                <ListBox ItemsSource="{Binding LogLines}" BorderThickness="0" Background="Transparent" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ItemContainerStyle="{DynamicResource CompactItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding [Log], Source={x:Static app:Loc.Instance}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Text.Mono}" Foreground="{DynamicResource Brush.TextTertiary}" Text="{Binding Time}" />
                                <TextBlock x:Name="Level" Grid.Column="1" Style="{StaticResource Text.Mono}" FontWeight="SemiBold" Text="{Binding Level}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Text.Mono}" Text="{Binding Text}" TextWrapping="Wrap" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="SUCCESS">
                                    <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="FAIL">
                                    <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="WARN">
                                    <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="RETRY">
                                    <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <TextBlock Grid.Row="3" Style="{StaticResource Text.Heading}" Margin="0,14,0,8" Text="{Binding [FailureInspector], Source={x:Static app:Loc.Instance}}" AutomationProperties.HeadingLevel="Level2" />
            <DataGrid Grid.Row="4" ItemsSource="{Binding FailedRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                      AutomationProperties.Name="{Binding [FailureInspector], Source={x:Static app:Loc.Instance}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding [ColTime], Source={x:Static app:Loc.Instance}}" Binding="{Binding Time}" Width="140" />
                    <DataGridTextColumn Header="{Binding [ColFile], Source={x:Static app:Loc.Instance}}" Binding="{Binding FileName}" Width="*" MinWidth="160" />
                    <DataGridTextColumn Header="{Binding [ColSize], Source={x:Static app:Loc.Instance}}" Binding="{Binding Size}" Width="80" />
                    <DataGridTextColumn Header="{Binding [ColHttp], Source={x:Static app:Loc.Instance}}" Binding="{Binding HttpStatus}" Width="55" />
                    <DataGridTextColumn Header="{Binding [ColAttempt], Source={x:Static app:Loc.Instance}}" Binding="{Binding Attempts}" Width="70" />
                    <DataGridTextColumn Header="{Binding [ColMessage], Source={x:Static app:Loc.Instance}}" Binding="{Binding Message}" Width="2*" MinWidth="200" />
                    <DataGridTextColumn Header="{Binding [ColUrl], Source={x:Static app:Loc.Instance}}" Binding="{Binding Url}" Width="*" MinWidth="140" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
